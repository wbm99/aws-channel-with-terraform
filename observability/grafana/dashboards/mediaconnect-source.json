          "metricName": "SourceConnected",
          "statistic": "Maximum",
          "expression": "REMOVE_EMPTY(SEARCH('{AWS/MediaConnect,FlowARN} MetricName=\"SourceConnected\" live-sports-aws-demo', 'Maximum', 5))",
          "period": "5",
          "id": "",
          "label": "${PROP('Dim.FlowARN')}"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*:([^:]+)$",
            "renamePattern": "$1"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no source",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "connected",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "disconnected",
                  "color": "red",
                  "index": 1
