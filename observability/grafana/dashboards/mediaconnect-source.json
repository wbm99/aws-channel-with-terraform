      "title": "Connected",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "default",
          "namespace": "AWS/MediaConnect",
          "metricName": "SourceConnected",
          "statistic": "Maximum",
          "expression": "SEARCH('{AWS/MediaConnect,FlowARN} MetricName=\"SourceConnected\" live-sports-aws-demo', 'Maximum', 5)",
          "period": "5",
          "id": "",
          "label": "${PROP('Dim.FlowARN')}"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*:([^:]+)$",
            "renamePattern": "$1"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "connected",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "disconnected",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "no source"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
