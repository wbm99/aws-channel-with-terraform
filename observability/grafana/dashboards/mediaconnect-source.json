    {
      "id": 11,
      "type": "table",
      "title": "Source events",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "description": "MediaConnect source health, alerts and flow status changes, from the EventBridge log group the observability module fills.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "id": "",
          "region": "default",
          "logGroupNames": [
            "/aws/events/live-sports-aws-demo"
          ],
          "expression": "filter `detail-type` in [\"MediaConnect Source Health\", \"MediaConnect Alert\", \"MediaConnect Flow Status Change\"]\n| fields replace(`detail-type`, \"MediaConnect \", \"\") as Event, coalesce(detail.current.state, detail.currentStatus, `detail.error-code`) as State, detail.errored as Alert, coalesce(`detail.error-message`, detail.previousStatus) as Detail\n| sort @timestamp desc\n| limit 50",
          "statsGroups": []
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "@timestamp",
                "Event",
                "State",
                "Alert",
                "Detail"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "@timestamp": "Time"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Alert"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "raised",
                        "color": "red",
                        "index": 0
                      },
