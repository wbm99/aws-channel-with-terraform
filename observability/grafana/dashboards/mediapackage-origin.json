      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "description": "Requests (normally from CloudFront) that the origin answered with 4xx or 5xx in the last 5 minutes, all request types together. Whether a request refused for CDN authorization also counts here is not established. Expect a few manifest 4xx when going live with a player already open: in every recorded session they came in the minutes before MediaLive's first push, when the manifest did not exist yet. 0 or none: no such request.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "default",
          "namespace": "AWS/MediaPackage",
          "metricName": "EgressRequestCount",
          "statistic": "Sum",
          "expression": "SUM(REMOVE_EMPTY(SEARCH('{AWS/MediaPackage,ChannelGroup,Channel,OriginEndpoint,StatusCode,RequestType} MetricName=\"EgressRequestCount\" ChannelGroup=\"live-sports-aws-demo\" StatusCode=\"4xx\"', 'Sum', 60)))",
          "period": "60",
          "id": "",
          "label": "4xx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "default",
          "namespace": "AWS/MediaPackage",
          "metricName": "EgressRequestCount",
          "statistic": "Sum",
          "expression": "SUM(REMOVE_EMPTY(SEARCH('{AWS/MediaPackage,ChannelGroup,Channel,OriginEndpoint,StatusCode,RequestType} MetricName=\"EgressRequestCount\" ChannelGroup=\"live-sports-aws-demo\" StatusCode=\"5xx\"', 'Sum', 60)))",
          "period": "60",
          "id": "",
          "label": "5xx"
        }
      ],
