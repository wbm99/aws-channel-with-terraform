    "live-sports-aws",
    "mediapackage"
  ],
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "description": "The live-sports-aws demo origin, from CloudWatch at a 60-second period: pushes from MediaLive, requests from CloudFront and CDN authorization, in signal order.",
  "links": [
    {
      "type": "link",
      "title": "MediaConnect source",
      "url": "/d/mediaconnect-source",
      "keepTime": true,
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Transport stream & SRT",
      "url": "/d/mediaconnect-detail",
      "keepTime": true,
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "MediaLive channel",
      "url": "/d/medialive-channel",
      "keepTime": true,
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "CloudFront distribution",
      "url": "/d/cloudfront-distribution",
      "keepTime": true,
      "icon": "dashboard",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Ingest bitrate",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "description": "What MediaLive pushed, averaged over the last 5 minutes, in megabits per second; about 9.9 for the whole ladder. \"Number of bytes of content that MediaPackage receives for each input request.\"",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "default",
          "namespace": "AWS/MediaPackage",
          "metricName": "IngressBytes",
          "statistic": "Sum",
          "expression": "REMOVE_EMPTY(SEARCH('{AWS/MediaPackage,ChannelGroup,Channel} MetricName=\"IngressBytes\" ChannelGroup=\"live-sports-aws-demo\"', 'Sum', 60)) * 8 / 60 / 1000000",
          "period": "60",
          "id": "",
          "label": "Ingest"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "Mbits",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "timeFrom": "5m",
      "hideTimeOverride": true,
      "id": 1
    },
    {
      "type": "stat",
      "title": "Push errors, last 5 min",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "description": "Pushes from MediaLive that MediaPackage refused (4xx) or failed (5xx) in the last 5 minutes. 0 or none, in a neutral colour: no such request, the healthy case. A status class exists only once a request in it has happened.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "default",
          "namespace": "AWS/MediaPackage",
          "metricName": "IngressRequestCount",
          "statistic": "Sum",
          "expression": "REMOVE_EMPTY(SEARCH('{AWS/MediaPackage,ChannelGroup,Channel,StatusCode} MetricName=\"IngressRequestCount\" ChannelGroup=\"live-sports-aws-demo\" StatusCode=\"4xx\"', 'Sum', 60))",
          "period": "60",
          "id": "",
          "label": "4xx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "default",
          "namespace": "AWS/MediaPackage",
          "metricName": "IngressRequestCount",
          "statistic": "Sum",
          "expression": "REMOVE_EMPTY(SEARCH('{AWS/MediaPackage,ChannelGroup,Channel,StatusCode} MetricName=\"IngressRequestCount\" ChannelGroup=\"live-sports-aws-demo\" StatusCode=\"5xx\"', 'Sum', 60))",
          "period": "60",
          "id": "",
          "label": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "transparent"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          },
          "noValue": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "4xx"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "5xx"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "timeFrom": "5m",
      "hideTimeOverride": true,
      "id": 2
    },
    {
      "type": "stat",
      "title": "Input active",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "description": "Whether the channel has an active input, from the ActiveInput metric. This metric is not in the MediaPackage user guide: it read 1 throughout every session so far, and what it reads when input stops (0, or no data) is a live check.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "default",
          "namespace": "AWS/MediaPackage",
          "metricName": "ActiveInput",
          "statistic": "Minimum",
          "expression": "REMOVE_EMPTY(SEARCH('{AWS/MediaPackage,ChannelGroup,Channel,InputIndex} MetricName=\"ActiveInput\" ChannelGroup=\"live-sports-aws-demo\"', 'Minimum', 60))",
          "period": "60",
          "id": "",
          "label": "Input active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "transparent"
              }
            ]
          },
          "noValue": "\u2014",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "inactive",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "active",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "min"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "timeFrom": "5m",
      "hideTimeOverride": true,
      "id": 3
    },
    {
