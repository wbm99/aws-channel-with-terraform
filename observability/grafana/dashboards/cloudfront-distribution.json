      "title": "Delivered",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "description": "What CloudFront sent to viewers, as bits per second (bytes a minute × 8 ÷ 60).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "us-east-1",
          "namespace": "AWS/CloudFront",
          "metricName": "BytesDownloaded",
          "statistic": "Sum",
          "expression": "REMOVE_EMPTY(SEARCH('{AWS/CloudFront,DistributionId,Region} MetricName=\"BytesDownloaded\" $distribution', 'Sum', 60)) * 8 / 60",
          "period": "60",
          "id": "",
          "label": "${PROP('Dim.DistributionId')}"
