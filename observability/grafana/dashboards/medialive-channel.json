    {
      "type": "stat",
      "title": "Input loss, last 5 min",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "description": "Whether input was lost at any point in the last 5 minutes: MediaLive showed its input-loss slate. A count of seconds is not possible: the metric adds 1 a second while input is lost, then subtracts most of it in one negative sample when input returns.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "default",
          "namespace": "AWS/MediaLive",
          "metricName": "InputLossSeconds",
          "statistic": "Maximum",
          "expression": "REMOVE_EMPTY(SEARCH('{AWS/MediaLive,ChannelId,Pipeline} MetricName=\"InputLossSeconds\" $channel', 'Maximum', 5))",
          "period": "5",
          "id": "",
          "label": "${PROP('Dim.ChannelId')}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2014",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.01,
                "color": "red"
              }
            ]
          },
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "none",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.01,
                "to": 1000000,
                "result": {
                  "text": "lost",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "timeFrom": "5m",
      "hideTimeOverride": true,
      "id": 3
    },
