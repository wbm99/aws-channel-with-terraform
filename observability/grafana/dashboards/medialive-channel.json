    {
      "type": "table",
      "title": "Channel events",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "description": "MediaLive channel state changes and alerts, from the EventBridge log group the observability module fills. Detail falls back to the whole event when it carries no message.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "id": "",
          "region": "default",
          "logGroupNames": [
            "/aws/events/live-sports-aws-demo"
          ],
          "expression": "filter `detail-type` like /^MediaLive /\n| fields replace(`detail-type`, \"MediaLive \", \"\") as Event, coalesce(detail.alarm_state, detail.state) as State, detail.alert_type as Alert, coalesce(detail.message, @message) as Detail\n| sort @timestamp desc\n| limit 50",
          "statsGroups": []
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "@timestamp",
                "Event",
                "State",
                "Alert",
                "Detail"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "@timestamp": "Time"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "id": 14
    }
