{
  "uid": "medialive-channel",
  "title": "MediaLive channel",
  "tags": [
    "live-sports-aws",
    "medialive"
  ],
  "timezone": "utc",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "description": "The live-sports-aws demo channel, from CloudWatch at a 5-second period: input, encoder, the push to MediaPackage and audio, in signal order.",
  "links": [
    {
      "type": "link",
      "title": "MediaConnect source",
      "url": "/d/mediaconnect-source",
      "keepTime": true,
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Transport stream & SRT",
      "url": "/d/mediaconnect-detail",
      "keepTime": true,
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "MediaPackage origin",
      "url": "/d/mediapackage-origin",
      "keepTime": true,
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "CloudFront distribution",
      "url": "/d/cloudfront-distribution",
      "keepTime": true,
      "icon": "dashboard",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "channel",
        "label": "Channel",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "description": "All shows whichever channel has data in the range: the running one. The list also holds destroyed channels from the last two weeks.",
        "query": {
          "queryType": "dimensionValues",
          "region": "default",
          "namespace": "AWS/MediaLive",
          "metricName": "ActiveAlerts",
          "dimensionKey": "ChannelId",
          "dimensionFilters": {},
          "refId": "A"
        },
        "includeAll": true,
        "allValue": "ChannelId",
        "multi": false,
        "refresh": 1,
        "sort": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Active alerts",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "description": "Alerts MediaLive has raised on the channel and not cleared. The Channel events table names them.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "default",
          "namespace": "AWS/MediaLive",
          "metricName": "ActiveAlerts",
          "statistic": "Maximum",
          "expression": "REMOVE_EMPTY(SEARCH('{AWS/MediaLive,ChannelId,Pipeline} MetricName=\"ActiveAlerts\" $channel', 'Maximum', 5))",
          "period": "5",
          "id": "",
          "label": "${PROP('Dim.ChannelId')}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2014",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "timeFrom": "2m",
      "hideTimeOverride": true,
      "id": 1
    },
    {
