# Copy to .env (gitignored) and change what you need; every line is optional.

# Port on this machine for the console. It is always bound to 127.0.0.1, never to the network.
CONSOLE_PORT=8765

# AWS profile from ~/.aws/config to act as. For SSO profiles, run `aws sso login --profile <name>` on the host first.
AWS_PROFILE=default

# Your user and group IDs (`id -u`, `id -g`), so files the container writes in the checkout belong to you.
UID=1000
GID=1000

# Port on this machine for Grafana (always bound to 127.0.0.1).
GRAFANA_PORT=3000

# Grafana's admin password, read only when Grafana first creates its database. Empty means admin, changed at first login.
GRAFANA_ADMIN_PASSWORD=

# Region Grafana reads CloudWatch from: the region the stack is deployed in.
AWS_REGION=us-east-1
